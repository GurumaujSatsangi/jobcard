# PostgreSQL
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

# Signs technician access tokens (JWT). At least 32 random characters.
JWT_SECRET=
# Key for passcode lookups. At least 32 random characters. Changing it invalidates every passcode.
PASSCODE_PEPPER=

# Optional
PORT=3000
# NODE_ENV=production   -> cookies are sent over HTTPS only
# TRUST_PROXY=1         -> set when behind nginx / a load balancer
