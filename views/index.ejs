<%- include("partials/head") %>
<%- include("partials/header") %>

<main class="flex-grow-1 page">
  <div class="container">
    <div class="page-head">
      <h1>Online Job Card Portal</h1>
      <p>Apply for and track repair job cards for the AC &amp; Refrigeration, Glass Blowing, Electrical, Mechanical and Intercom / EPABX Sections.</p>
    </div>

    <div class="row g-5 mb-8">
      <div class="col-12 md:col-6">
        <section class="panel panel-body action-card">
          <h2><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> New Job Card Application</h2>
          <p>Apply for a new job card. You will get an Application Reference Number (ARN) to track it.</p>
          <button type="button" class="btn btn-solid theme-primary" data-bs-toggle="dialog" data-bs-target="#newJobCardDialog">Apply now</button>
        </section>
      </div>
      <div class="col-12 md:col-6">
        <section class="panel panel-body action-card">
          <h2><i class="bi bi-search" aria-hidden="true"></i> Check Application Status</h2>
          <p>Check the status of a job card you have already applied for, using its ARN.</p>
          <button type="button" class="btn btn-outline theme-primary" data-bs-toggle="dialog" data-bs-target="#statusDialog">Check status</button>
        </section>
      </div>
    </div>

    <!-- Live charts (public/js/stats.js), refreshed every 10 minutes -->
    <section class="stats mb-8" id="stats" aria-labelledby="statsTitle">
      <div class="stats-head">
        <h2 class="h5 m-0" id="statsTitle">Job cards at a glance</h2>
        <span class="small text-muted-2" id="statsUpdated" aria-live="polite">Loading…</span>
      </div>
      <div class="row g-5">
        <div class="col-12 md:col-6">
          <figure class="panel panel-body chart-card m-0" data-chart="ac">
            <figcaption class="chart-title">AC &amp; Refrigeration Section</figcaption>
            <p class="chart-sub">Job cards submitted by users vs preventive services</p>
            <div class="chart-body"></div>
          </figure>
        </div>
        <div class="col-12 md:col-6">
          <figure class="panel panel-body chart-card m-0" data-chart="sections">
            <figcaption class="chart-title">Job cards by section</figcaption>
            <p class="chart-sub">All job card applications, by the section they were sent to</p>
            <div class="chart-body"></div>
          </figure>
        </div>
      </div>
      <div class="chart-tip" id="chartTip" role="status" hidden></div>
    </section>

    <div class="row g-5">
      <div class="col-12 md:col-6">
        <h2 class="h5 mb-3">Section contacts</h2>
        <ul class="contact-list">
          <% SECTIONS.forEach(s => { %>
          <li><span><%= s.label %></span><span>Ext. <%= s.extension %></span></li>
          <% }) %>
        </ul>
      </div>
      <div class="col-12 md:col-6">
        <h2 class="h5 mb-3">Help desk</h2>
        <p class="mb-2">For any query about the portal, write to <a href="mailto:<%= HELPDESK.email %>"><%= HELPDESK.email %></a> or call Extension <strong><%= HELPDESK.extension %></strong>.</p>
        <p class="text-muted-2 small mb-0">Use your official @<%= OFFICIAL_EMAIL_DOMAIN %> email when applying. Keep your ARN safe; you need it to check the status.</p>
      </div>
    </div>
  </div>
</main>

<%- include("partials/status-dialog") %>
<%- include("partials/new-job-card-dialog") %>
<%- include("partials/crew-search-dialog") %>
<%- include("partials/qr-scan-dialog") %>
<%# QR code reader (global jsQR), loaded as a classic script. %>
<script src="/vendor/jsqr/jsQR.js" defer></script>
<%- include("partials/footer", { scripts: ["/js/stats.js"] }) %>
