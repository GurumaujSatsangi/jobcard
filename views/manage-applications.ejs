<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles.css">
    
</head>
<body>

    <%- include('partials/navbar') %>
     
    <div class="container">
        <table class="table">
            <tr>
                <th><h5>APPLICATION REFERENCE NUMBER</h5></th>
                <th><h5>STATUS</h5></th>
            </tr>
            <tr>
                <th><h5 style="color:blue;"><%= result.arn %></h5></th>
                <th>
                    <% if(result.status=="APPLICATION SUBMITTED") { %>
                        <h5 style="color:red">APPLICATION SUBMITTED</h5>
                    <% } else if(result.status=="TECHNICIAN ASSIGNED"){ %>
                        <h5 style="color:blue">TECHNICIAN ASSIGNED</h5>
                    <% } else if(result.status=="MATERIAL ISSUED BY STORE IN-CHARGE"){%>

                        <h5 style="color:yellow">MATERIAL ISSUED BY STORE IN-CHARGE</h5>
                    <% } else if(result.status=="COMPLETED"){%>
                        <h5 style="color:green">COMPLETED</h5>
                    <% } %>
                        
                </th>
            </tr>
        </table>
    <table class="table">
        <tr>
            <th>SECTION</th>
            <th>CREW SERIAL NUMBER</th>
            <th>INDENTOR</th>
            <th>DESCRIPTION</th>
            <th>AMC DETAILS</th>
        </tr>
        <tr>
            <td><%= result.section %></td>
            <td><%= result.crew_serial_number %></td>
            <td><%= result.indentor %></td>
            <td><%= result.description %></td>
            <td><%= result.amc %></td>
        </tr>

    </table>
    <form action="/assign-technician/<%= result.arn %>" method="post">
      <select name="assigned_technician">
            <% if (Array.isArray(technician) && technician.length > 0) { %>
            <% technician.forEach(function(technician){ %>
            <option class="form-control" value="<%= technician.technician_name %>"><%= technician.technician_name %> (ID: <%= technician.technician_id %>)</option>
            <% }) %>
            <% } %>
        </select>
    <input class="btn btn-primary" type="submit" value="Assign Technician">
    </form>

    </div>
    <%-include('partials/footer') %>
</body>
</html>