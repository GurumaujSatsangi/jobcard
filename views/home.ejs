<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
  <link rel="stylesheet" href="/styles.css">

</head>
<body>
    <%- include('partials/navbar.ejs') %>
  <div class="container">

    <h4>Submit New Application</h4><hr>

    <% if(myacs && myacs.length>0){ %>

      <% myacs.forEach(function(myacs){ %>
      
      
  <div class="card">
  <div class="card-body">
    <h5 class="card-title"><%= myacs.crew_serial_number %></h5>
    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
    <button type="button" class="btn btn-primary" data-mdb-ripple-init>Button</button>
  </div>
</div>
      <% }) %>
    
    
    <% } else { %>
      <p class="small">No Air Conditioners Assigned to You!</p>

      <% } %>



<hr>
    <h4>My Applications</h4><hr>

    <% if(mysubmissions && mysubmissions.length>0) { %>

      <table class="table">

        <tr>
          <th>Application Reference Number</th>
          <th>Section</th>
          <th>CREW Serial Number</th>
          <th>Description</th>
          <th>Status</th>
          <th>Action</th>
        </tr>

      <% mysubmissions.forEach(function(mysubmissions){ %>
      <tr>
        <td>
<%= mysubmissions.arn %>
        </td>
        <td>
<%= mysubmissions.arn %>

        </td>
        <td><%= mysubmissions.crew_serial_number %>


        </td>
        <td>
<%= mysubmissions.description %>

        </td>
         <td>
              <%= mysubmissions.status %>


                </td>
                <td>
                  <a href="/delete/<%= mysubmissions.arn %>" class="btn btn-danger">Delete</a>
                </td>
      </tr>
      
      <% }) %>
      </table>
    
    <% } else { %>

      <p class="small">No Applications Found!</p>

      <% } %>

  </div>

    <%- include('partials/footer') %>
  
</body>
</html>