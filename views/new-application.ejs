<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h4>CREW Serial Number: <%= result.crew_serial_number %></h4>
    <hr>
    <form action="/submit-new-application" method="post">

        <input type="hidden" name="crew_serial_number" value="<%= result.crew_serial_number%>">

        <label>Select Indentor</label>
        <p class="small">The dropdown below show the list of possible Indentors for a Job Card Application for this Air Conditioner (<%= result.crew_serial_number %>). If you think your name should be there but is not there, please CLICK HERE.</p>
        <hr>
        <select name="indentor">
            <% if (Array.isArray(result.assigned_to) && result.assigned_to.length > 0) { %>
            <% result.assigned_to.forEach(function(person){ %>
            <option value="<%= person %>"><%= person %></option>
            <% }) %>
            <% } %>
        </select>

        <input type="submit" value="Submit">
    </form>
</body>
</html>