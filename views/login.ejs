
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
  
<link rel="stylesheet" href="/styles.css" />

</head>
<body>
<%-include('partials/navbar') %>
    <div class="container">
    <form action="/login" method="post">
  <!-- Email input -->
  <div data-mdb-input-init class="form-outline mb-4">
    <input required type="text" id="emp_id" name="emp_id" class="form-control" />
    <label class="form-label" for="emp_id">Employee ID</label>
  </div>

  <!-- Password input -->
  <div data-mdb-input-init class="form-outline mb-4">
    <input required type="password" id="form2Example2" name="password" class="form-control" />
    <label class="form-label" for="form2Example2">Password</label>
  </div>

  <!-- 2 column grid layout for inline styling -->
  <div class="row mb-4">


    <div class="col">
      <!-- Simple link -->
      <a href="#!">Forgot password?</a>
    </div>
  </div>

  <!-- Submit button -->
<button id="loginbtn" type="submit" class="btn btn-primary btn-block mb-2">
  <span id="spinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
  <span id="btn-text">Sign in</span>
</button>
  <!-- Register buttons -->

</form>
    </div>


<div class="spinner-border" role="status">
  <span class="visually-hidden">Loading...</span>
</div>


<script>
  const button = document.getElementById("loginbtn");
  const spinner = document.getElementById("spinner");

  button.addEventListener("click", function() {
    // Toggle the 'd-none' class to show/hide the spinner
    spinner.classList.toggle("d-none");
    
    // Optional: Disable button while loading to prevent multiple clicks
    // this.disabled = true;
  });
</script>


    <%- include('partials/footer') %>
</body>
</html>
<!-- Font Awesome -->


