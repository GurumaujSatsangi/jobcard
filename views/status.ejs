<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <form action="/fetch-status" method="post">
        <input type="text" name="crew_serial_number">
        <input type="submit" value="Fecth Status">
    </form>

    <% if (data) { %>

        <table style="border: 1px solid black" cellpadding="10" cellspacing="10">
            <tr>
                <th>CREW SERIAL NUMBER</th>
                <th>INDENTOR</th>
                <th>STATUS</th>
            </tr>
            <tr>
                <td><%= data.crew_serial_number%></td>
                <td><%= data.indentor %></td>
                <td>
                  <% let currentStep = 0; %>
                  <% if (data.status === "APPLICATION SUBMITTED") { %>
                    <% currentStep = 1; %>
                  <% } else if (data.status === "TECHNICIAN ASSIGNED") { %>
                    <% currentStep = 2; %>
                  <% } else if (data.status === "MATERIALS ISSUED BY STORE IN-CHARGE") { %>
                    <% currentStep = 3; %>
                  <% } else if (data.status === "APPLICATION CLOSED") { %>
                    <% currentStep = 4; %>
                  <% } else if (data.status === "FEEDBACK FORM ENABLED") { %>
                    <% currentStep = 5; %>
                  <% } %>

                  <div class="stepper-wrapper">
                    <div class="stepper-item">
                      <div class="step-counter <%= currentStep >= 1 ? 'step-complete' : 'step-pending' %>">1</div>
                      <div class="step-name">Application Submitted</div>
                    </div>
                    <div class="stepper-item">
                      <div class="step-counter <%= currentStep >= 2 ? 'step-complete' : 'step-pending' %>">2</div>
                      <div class="step-name">Technician Assigned</div>
                      <br>(<%= data.assigned_technician %>)
                    </div>
                    <div class="stepper-item">
                      <div class="step-counter <%= currentStep >= 3 ? 'step-complete' : 'step-pending' %>">3</div>
                      <div class="step-name">Materials Issued by Store In-Charge</div>
                    </div>
                    <div class="stepper-item">
                      <div class="step-counter <%= currentStep >= 4 ? 'step-complete' : 'step-pending' %>">4</div>
                      <div class="step-name">Application Closed</div>
                    </div>
                    <div class="stepper-item">
                      <div class="step-counter <%= currentStep >= 5 ? 'step-complete' : 'step-pending' %>">5</div>
                      <div class="step-name">Feedback Form Enabled</div>
                    </div>
                  </div>





                </td>
            </tr>
        </table>
    
    <% } %>


    <style>
  :root {
    --bg-color: #ffffff;
    --line-color: #72aadc;
    --text-color: black;
    --number-color: #4f8ab9;
    --circle-size: 44px;
    --line-thickness: 4px;
  }

  .stepper-wrapper {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 800px; /* Adjust based on your layout needs */
  }

  .stepper-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }

  /* The connecting lines */
  .stepper-item::before {
    content: "";
    position: absolute;
    top: calc(var(--circle-size) / 2 - (var(--line-thickness) / 2));
    left: -50%;
    width: 100%;
    height: var(--line-thickness);
    background-color: black;
    z-index: 1;
  }

  /* Remove the line before the first item */
  .stepper-item:first-child::before {
    display: none;
  }

  .step-counter {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    width: var(--circle-size);
    height: var(--circle-size);
    border-radius: 50%;
    background-color: yellow;
    color: black;
    font-weight: bold;
    font-size: 16px;
    margin-bottom: 12px;
  }

  .step-complete {
    background-color: green;
    color: white;
  }

  .step-pending {
    background-color: yellow;
    color: black;
  }

  .step-name {
    color: var(--text-color);
    font-weight: 700;
    font-size: 15px;
    text-align: center;
  }
</style>



</body>
</html>