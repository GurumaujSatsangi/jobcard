<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container">
<% if (!result) { %>
<p><%= error || 'No AC record found.' %></p>
<% } else { %>
<table class="table">
    <tr>
        <th>CREW Serial Number</th>
        <th>Brand</th>
        <th>Room Number</th>
    </tr>
    <tr>
        <td>
            <%= result.crew_serial_number%>

        </td>
        <td>
            <%= result.brand%>
        </td>
        <td>
            <%= result.room_number%>
        </td>
    </tr>
</table>


        <hr>
    <form action="/submit-new-application" method="post">

        <input type="hidden" name="crew_serial_number" value="<%= result.crew_serial_number%>">

<div class="form-outline" data-mdb-input-init>
  <textarea placeholder="Describe your Issue" class="form-control" id="textAreaExample" rows="4"></textarea>
  <label class="form-label" for="textAreaExample">Message</label>
</div>
        </textarea>

        <input class="btn btn-primary" type="submit" value="Submit">
    </form>
<% } %>
    </div>
    <%- include('partials/footer') %>
</body>
</html>