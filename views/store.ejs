<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <h4>Store In-Charge Panel</h4><hr>

        <h5>Issue Items</h5><hr>

    <% if(applications && applications.length>0) { %>

        <table class="table">
            <tr>
                <th>ARN</th>
                <th>ASSIGNED TECHNICIAN</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>

        <% applications.forEach(function(applications){ %>

            <tr>
                <td><%= applications.arn %></td>
                <td><%= applications.assigned_technician %></td>
                <td><%= applications.status %></td>
                <td><a href="/issue/<%= applications.arn%>" class="btn btn-primary">Issue</a>
                <a href="/store/report/<%= applications.arn %>" class="btn btn-danger">Report</a>
                </td>

            </tr>
        
        
        <% }) %>
    
            </table>

    <% } else { %>
        <p class="small">No Applications Found!</p>

        <% } %>

    <h5>Manage Inventory</h5>
    <a href="/store/dashboard/new-item" class="btn btn-success">Add New Item</a>    
    <a href="/store/dashboard/new-inventory-record" class="btn btn-warning">Add New Inventory Record</a>

    <hr>

    <% if(items && items.length>0){ %>

        <table class="table">
            
            <tr>
                <th>ITEM CODE</th>
                <th>ITEM NAME</th>
                <th>AVAILABLE QUANTITY</th>
                <th>ACTION</th>
            </tr>


    <% items.forEach(function(items){ %>

<tr>
    <td><%= items.item_code%></td>
    <td><%= items.item_name%></td>
    <td><%= items.qty %></td>
    <td><a href="/manage-item/<%= items.item_code %>" class="btn btn-primary">Manage</a></td>
</tr>
    
    
    <% }) %>
            </table>

    
    <% } else { %>
<p class="small">No Items Found!</p>
        <% } %>

    </div>


    <%-include('partials/footer') %>
    
</body>
</html>