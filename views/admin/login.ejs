<%- include("../partials/head") %>
<%- include("../partials/header", { hideNotice: true }) %>

<main class="flex-grow-1 page">
  <div class="container">
    <div class="panel signin">
      <div class="panel-body">
        <h1>Admin sign in</h1>
        <p class="sub">Use your official email and password</p>

        <% if (error) { %>
          <div class="flash flash-err text-start" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i><span><%= error %></span>
          </div>
        <% } %>

        <form method="post" action="/admin/login" class="text-start" id="adminLoginForm">
          <div class="field">
            <label class="form-label" for="email">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="<%= email %>" required autocomplete="username" autofocus placeholder="yourname@<%= OFFICIAL_EMAIL_DOMAIN %>">
          </div>
          <div class="field mb-6">
            <label class="form-label" for="password">Password</label>
            <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password">
          </div>
          <button type="submit" class="btn btn-solid theme-primary btn-lg w-100">Sign in</button>
        </form>

        <p class="help">Forgot your password? Ask the portal administrator to reset it.</p>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
