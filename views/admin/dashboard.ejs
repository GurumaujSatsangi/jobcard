<%- include("../partials/head") %>
<%- include("../partials/header") %>

<main class="flex-grow-1 page">
  <div class="container">
    <div class="page-head">
      <h1>Admin</h1>
      <p><%= admin.name %> &middot; <%= admin.department %> &middot; Ext. <%= admin.contact_number %></p>
    </div>

    <div class="row g-5">
      <div class="col-12 md:col-4">
        <section class="panel panel-body action-card">
          <h2><i class="bi bi-card-checklist" aria-hidden="true"></i> Manage job card applications</h2>
          <p>View all job cards, filter by section, search by ARN or CREW number, and assign technicians.</p>
          <button type="button" class="btn btn-solid theme-primary" data-bs-toggle="dialog" data-bs-target="#jobsDialog">Open</button>
        </section>
      </div>
      <div class="col-12 md:col-4">
        <section class="panel panel-body action-card">
          <h2><i class="bi bi-snow" aria-hidden="true"></i> Manage AC database</h2>
          <p>Add, edit or remove ACs in the inventory used for CREW number lookups.</p>
          <button type="button" class="btn btn-solid theme-primary" data-bs-toggle="dialog" data-bs-target="#acDialog">Open</button>
        </section>
      </div>
      <div class="col-12 md:col-4">
        <section class="panel panel-body action-card">
          <h2><i class="bi bi-tools" aria-hidden="true"></i> Preventive service</h2>
          <p>Raise preventive services for ACs under AMC and track them. Reset the register every April.</p>
          <button type="button" class="btn btn-solid theme-primary" data-bs-toggle="dialog" data-bs-target="#psDialog">Open</button>
        </section>
      </div>
      <div class="col-12 md:col-4">
        <section class="panel panel-body action-card">
          <h2><i class="bi bi-diagram-3" aria-hidden="true"></i> Manage sections</h2>
          <p>The five workshop sections and their technicians. Add, edit or remove IACS and AMC technicians.</p>
          <button type="button" class="btn btn-solid theme-primary" data-bs-toggle="dialog" data-bs-target="#sectionsDialog">Open</button>
        </section>
      </div>
      <div class="col-12 md:col-4">
        <section class="panel panel-body action-card">
          <h2><i class="bi bi-journal-text" aria-hidden="true"></i> Memo record book</h2>
          <p>See all memos recorded by the store and add a new one.</p>
          <button type="button" class="btn btn-solid theme-primary" data-bs-toggle="dialog" data-bs-target="#memoDialog">Open</button>
        </section>
      </div>
    </div>
  </div>
</main>

<!-- ============ Job cards ============ -->
<dialog class="dialog dialog-xl dialog-scrollable admin-dialog" id="jobsDialog" aria-labelledby="jobsTitle">
  <div class="dialog-header">
    <h2 class="dialog-title" id="jobsTitle">Job card applications</h2>
    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
  </div>
  <div class="dialog-body">
    <div data-view="list">
      <form class="toolbar" data-filters role="search">
        <input type="search" class="form-control" name="q" placeholder="Search ARN or CREW number" aria-label="Search ARN or CREW number">
        <select class="form-control" name="section" aria-label="Section">
          <option value="">All sections</option>
          <% SECTIONS.forEach(s => { %><option value="<%= s.value %>"><%= s.label %></option><% }) %>
        </select>
        <select class="form-control" name="status" aria-label="Status">
          <option value="open">Open</option>
          <option value="unassigned">Not yet assigned</option>
          <option value="closed">Closed</option>
          <option value="all">All</option>
        </select>
      </form>
      <div class="list-area" data-list></div>
    </div>

    <div data-view="detail" hidden>
      <button type="button" class="btn btn-subtle theme-secondary btn-sm mb-4" data-back><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</button>
      <div data-detail></div>
    </div>
  </div>
</dialog>

<!-- ============ AC database ============ -->
<dialog class="dialog dialog-xl dialog-scrollable admin-dialog" id="acDialog" aria-labelledby="acTitle">
  <div class="dialog-header">
    <h2 class="dialog-title" id="acTitle">AC database</h2>
    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
  </div>
  <div class="dialog-body">
    <div data-view="list">
      <form class="toolbar" data-filters role="search">
        <input type="search" class="form-control" name="q" placeholder="Search CREW number, room, in-charge, school or brand" aria-label="Search ACs">
        <button type="button" class="btn btn-outline theme-primary" data-import><i class="bi bi-upload" aria-hidden="true"></i> Import CSV</button>
        <button type="button" class="btn btn-solid theme-primary" data-add><i class="bi bi-plus-lg" aria-hidden="true"></i> Add AC</button>
      </form>
      <div class="list-area" data-list></div>
    </div>

    <div data-view="import" hidden>
      <button type="button" class="btn btn-subtle theme-secondary btn-sm mb-4" data-back><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</button>
      <h3 class="h5 mb-3">Import ACs from a CSV file</h3>
      <div class="flash flash-err" data-import-error role="alert" hidden></div>

      <div class="form-section">
        <div class="form-section-title">1. Fill in the template</div>
        <p class="mb-3">Open the template in Excel or Google Sheets, add one AC per row, and save it as <strong>CSV</strong>.</p>
        <ul class="small text-muted-2 mb-4">
          <li>Leave <strong>CREW Serial No.</strong> blank for new ACs; they're numbered automatically after the highest existing number.</li>
          <li>To update an existing AC, put its CREW Serial No. (e.g. <span class="font-monospace">IACS/CREW/AC/00042</span> or just <span class="font-monospace">42</span>). Only the cells you fill in are changed.</li>
          <li>Dates can be <span class="font-monospace">2026-04-01</span> or <span class="font-monospace">01.04.2026</span>; Yes/No columns accept Yes, No, Y or N.</li>
        </ul>
        <a class="btn btn-outline theme-primary btn-sm" href="/admin/api/ac-units/template.csv" download><i class="bi bi-download" aria-hidden="true"></i> Download template</a>
      </div>

      <div class="form-section">
        <div class="form-section-title">2. Upload and check</div>
        <label class="dropzone" for="acCsvFile">
          <i class="bi bi-filetype-csv" aria-hidden="true"></i>
          <span><strong>Choose a CSV file</strong></span>
          <span class="form-text m-0" data-file-name>Nothing is saved until you click Import.</span>
          <input type="file" id="acCsvFile" accept=".csv,text/csv" class="visually-hidden">
        </label>
      </div>

      <div data-import-preview></div>
    </div>

    <div data-view="detail" hidden>
      <button type="button" class="btn btn-subtle theme-secondary btn-sm mb-4" data-back><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</button>
      <form id="acForm" novalidate>
        <h3 class="h5 mb-1" data-form-title></h3>
        <p class="text-muted-2 small mb-5" data-form-sub></p>
        <div class="flash flash-err" data-form-error role="alert" hidden></div>
        <div data-fields></div>
        <div class="form-actions">
          <button type="button" class="btn btn-outline theme-danger" data-delete hidden><i class="bi bi-trash" aria-hidden="true"></i> Delete AC</button>
          <span class="flex-grow-1"></span>
          <button type="button" class="btn btn-subtle theme-secondary" data-back>Cancel</button>
          <button type="submit" class="btn btn-solid theme-primary" data-save>Save</button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<!-- ============ Preventive service ============ -->
<dialog class="dialog dialog-xl dialog-scrollable admin-dialog" id="psDialog" aria-labelledby="psTitle">
  <div class="dialog-header">
    <h2 class="dialog-title" id="psTitle">Preventive service</h2>
    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
  </div>
  <div class="dialog-body">
    <div data-view="list">
      <div class="ps-top">
        <div class="seg" role="tablist" aria-label="Preventive service views">
          <button type="button" role="tab" aria-selected="true" data-tab="acs">ACs under AMC</button>
          <button type="button" role="tab" aria-selected="false" data-tab="services">Applications</button>
        </div>
        <div class="ps-reset">
          <span class="small text-muted-2" data-reset-note></span>
          <button type="button" class="btn btn-outline theme-danger btn-sm" data-reset disabled>
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Download &amp; reset
          </button>
        </div>
      </div>

      <form class="toolbar" data-filters role="search">
        <input type="search" class="form-control" name="q" placeholder="Search CREW number, room, in-charge or school" aria-label="Search">
      </form>
      <div class="list-area" data-list></div>
    </div>

    <div data-view="apply" hidden>
      <button type="button" class="btn btn-subtle theme-secondary btn-sm mb-4" data-back><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to list</button>
      <form id="psForm" novalidate>
        <h3 class="h5 mb-4">Apply for preventive service</h3>
        <div class="flash flash-err" data-form-error role="alert" hidden></div>

        <div class="form-section">
          <div class="form-section-title">Air conditioner</div>
          <table class="kv-table"><tbody data-ac-summary></tbody></table>
        </div>

        <div class="form-section">
          <div class="form-section-title">Requested by (your profile)</div>
          <table class="kv-table">
            <tbody>
              <tr><th scope="row">Name</th><td><%= admin.name %></td></tr>
              <tr><th scope="row">Email</th><td><%= admin.email %></td></tr>
              <tr><th scope="row">Extension</th><td><%= admin.contact_number %></td></tr>
              <tr><th scope="row">School / Department / Section / Unit</th><td><%= admin.department %></td></tr>
            </tbody>
          </table>
        </div>

        <div class="form-section">
          <div class="form-section-title">Service</div>
          <div class="field">
            <label class="form-label" for="psTechnician">Technician <span class="req">*</span></label>
            <select class="form-control" id="psTechnician" name="technicianId" required></select>
            <div class="invalid-feedback" data-for="technicianId"></div>
          </div>
          <div class="field" role="radiogroup" aria-labelledby="psTypeLabel">
            <span class="field-label" id="psTypeLabel">Preventive service type <span class="req">*</span></span>
            <div class="choice-list two-col" data-types></div>
            <div class="invalid-feedback" data-for="serviceType"></div>
          </div>
        </div>

        <div class="form-actions">
          <span class="flex-grow-1"></span>
          <button type="button" class="btn btn-subtle theme-secondary" data-back>Cancel</button>
          <button type="submit" class="btn btn-solid theme-primary" data-save>Apply for preventive service</button>
        </div>
      </form>
    </div>

    <div data-view="reset" hidden>
      <button type="button" class="btn btn-subtle theme-secondary btn-sm mb-4" data-back><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button>
      <form id="psResetForm" novalidate>
        <h3 class="h5 mb-3">Reset the preventive service register</h3>
        <div class="flash flash-err" data-form-error role="alert" hidden></div>
        <p data-reset-summary></p>
        <ol class="mb-5">
          <li>All preventive service applications are downloaded as a CSV file (a copy is also kept on the server).</li>
          <li>The register is then emptied, so Preventive Service 1&ndash;4 can be raised again for every AC.</li>
        </ol>
        <div class="field">
          <label class="form-label" for="psResetConfirm">Type <strong>RESET</strong> to confirm</label>
          <input type="text" class="form-control" id="psResetConfirm" autocomplete="off" spellcheck="false">
        </div>
        <div class="form-actions">
          <span class="flex-grow-1"></span>
          <button type="button" class="btn btn-subtle theme-secondary" data-back>Cancel</button>
          <button type="submit" class="btn btn-solid theme-danger" data-save disabled>Download &amp; reset</button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<script type="application/json" id="adminData"><%- JSON.stringify({
  sections: SECTIONS.map(s => ({ value: s.value, label: s.label })),
  acFields,
  preventiveTypes,
}).replace(/</g, "\\u003c") %></script>

<!-- ============ Sections & technicians ============ -->
<dialog class="dialog dialog-xl dialog-scrollable admin-dialog" id="sectionsDialog" aria-labelledby="sectionsTitle">
  <div class="dialog-header">
    <h2 class="dialog-title" id="sectionsTitle">Manage sections</h2>
    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
  </div>
  <div class="dialog-body">
    <!-- The five sections -->
    <div data-view="sections">
      <div class="section-grid" id="sectionGrid"></div>
    </div>

    <!-- Technicians of one section -->
    <div data-view="techs" hidden>
      <button type="button" class="btn btn-subtle theme-secondary btn-sm mb-4" data-go="sections"><i class="bi bi-arrow-left" aria-hidden="true"></i> All sections</button>
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <h3 class="h5 m-0" id="techSectionTitle"></h3>
        <button type="button" class="btn btn-solid theme-primary" id="techAddBtn"><i class="bi bi-person-plus" aria-hidden="true"></i> Add technician</button>
      </div>
      <div id="techNote"></div>
      <div class="table-responsive">
        <table class="data-table tech-table">
          <thead><tr><th>Technician</th><th>Mobile</th><th>Ext.</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody id="techRows"></tbody>
        </table>
      </div>
      <div id="techMsg"></div>
    </div>

    <!-- Add / edit a technician -->
    <div data-view="techForm" hidden>
      <button type="button" class="btn btn-subtle theme-secondary btn-sm mb-4" data-go="techs"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to technicians</button>
      <form id="techForm" novalidate>
        <h3 class="h5 mb-1" id="techFormTitle"></h3>
        <p class="text-muted-2 small mb-5" id="techFormSub"></p>
        <div class="flash flash-err" data-form-error role="alert" hidden></div>
        <div class="telegram-block" id="telegramBlock" hidden>
          <div class="flash flash-warn" role="alert">
            <i class="bi bi-telegram" aria-hidden="true"></i>
            <div>
              <strong>Ask the technician to share their mobile number with the Telegram bot first.</strong>
              <div id="telegramMsg"></div>
            </div>
          </div>
          <button type="button" class="btn btn-outline theme-primary" id="telegramRetry" disabled>Retry</button>
          <span class="small text-muted-2 ms-2" id="telegramCountdown"></span>
        </div>

        <div class="field">
          <label class="form-label" for="tName">Name of the Technician <span class="req">*</span></label>
          <input type="text" class="form-control" id="tName" name="name" maxlength="255" autocomplete="off" required>
          <div class="invalid-feedback" data-for="name"></div>
        </div>
        <div class="field" role="radiogroup" aria-labelledby="tTypeLabel" aria-required="true">
          <span class="field-label" id="tTypeLabel">Staff type <span class="req">*</span></span>
          <div class="choice-list two-col">
            <label class="choice" for="tTypeIacs"><input class="radio" type="radio" name="staffType" id="tTypeIacs" value="IACS" required> <span>IACS Staff</span></label>
            <label class="choice" for="tTypeAmc"><input class="radio" type="radio" name="staffType" id="tTypeAmc" value="AMC"> <span>AMC Staff</span></label>
          </div>
          <div class="invalid-feedback" data-for="staffType"></div>
        </div>
        <div class="field" id="amcField" hidden>
          <label class="form-label" for="tAmc">Name of the AMC <span class="req">*</span></label>
          <input type="text" class="form-control" id="tAmc" name="amcName" maxlength="120" autocomplete="off">
          <div class="invalid-feedback" data-for="amcName"></div>
        </div>
        <div class="row g-4">
          <div class="col-12 md:col-6 field">
            <label class="form-label" for="tMobile">Mobile Number <span class="req">*</span></label>
            <input type="tel" class="form-control" id="tMobile" name="mobile" inputmode="numeric" maxlength="15" placeholder="10-digit mobile number" autocomplete="off" required>
            <div class="form-text">Must be the number the technician uses on Telegram.</div>
            <div class="invalid-feedback" data-for="mobile"></div>
          </div>
          <div class="col-12 md:col-6 field">
            <label class="form-label" for="tExt">Extension Number <span class="form-text">(optional)</span></label>
            <input type="text" class="form-control" id="tExt" name="extension" inputmode="numeric" maxlength="4" pattern="\d{1,4}" autocomplete="off">
            <div class="invalid-feedback" data-for="extension"></div>
          </div>
        </div>
        <div class="form-actions">
          <span class="flex-grow-1"></span>
          <button type="button" class="btn btn-subtle theme-secondary" data-go="techs">Cancel</button>
          <button type="submit" class="btn btn-solid theme-primary" id="techSubmit">Submit</button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<!-- ============ Memo record book ============ -->
<%- include("../partials/memo-dialog", { memoApi: "/admin/api/memos", loginUrl: "/admin/login" }) %>

<%- include("../partials/footer", { scripts: ["/js/admin.js", "/js/admin-sections.js", "/js/memos.js"] }) %>
