<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <% if(data && data.length>0) { %>
<ul>
        <% data.forEach(function(data){ %>

            <li>
                <%= data.crew_serial_number %> - <%= data.indentor %> - <%= data.status %> (<a href="/manage/<%=data.crew_serial_number%>">Manage</a>)
            </li>
        
        
        <% }) %>
    </ul>
    <% } %>
</body>
</html>