<%- include("../partials/head") %>
<%- include("../partials/header", { hideTicker: true }) %>

<main class="flex-grow-1 tech-page">
  <div class="container py-7 tech-container">
    <div class="mb-6">
      <h1 class="h3 mb-1">Hello, <%= technician.name %></h1>
      <p class="fg-3 mb-0"><i class="bi bi-diagram-3 me-1" aria-hidden="true"></i><%= sectionName %></p>
    </div>

    <% if (done) { %>
      <div class="alert theme-success tech-alert mb-6" role="status">
        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
        <div>
          <strong>Job <%= done %> is closed.</strong><br>
          The signed receipt was uploaded. Thank you!
        </div>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert theme-danger tech-alert mb-6" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div><%= error %></div>
      </div>
    <% } %>

    <h2 class="h5 mb-4">
      My Jobs <span class="badge theme-primary ms-1"><%= jobs.length %></span>
    </h2>

    <% if (!jobs.length) { %>
      <div class="card">
        <div class="card-body p-8 text-center">
          <i class="bi bi-emoji-smile tech-empty-icon" aria-hidden="true"></i>
          <p class="h5 mt-3 mb-1">No jobs right now</p>
          <p class="fg-3 mb-0">New jobs will appear here when they are assigned to you.</p>
        </div>
      </div>
    <% } %>

    <div class="d-grid gap-5">
      <% jobs.forEach((job, i) => { %>
      <article class="card job-card" id="job-<%= job.arn %>">
        <div class="card-body p-6">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
              <div class="small fg-3">ARN</div>
              <div class="job-arn font-monospace"><%= job.arn %></div>
            </div>
            <span class="small fg-3"><i class="bi bi-clock me-1" aria-hidden="true"></i>Assigned <%= job.assignedAt %></span>
          </div>

          <dl class="job-facts mb-5">
            <div><dt><i class="bi bi-geo-alt" aria-hidden="true"></i> Place</dt><dd><%= job.department %></dd></div>
            <div><dt><i class="bi bi-person" aria-hidden="true"></i> Contact</dt><dd><%= job.indentor %> &middot; Ext. <%= job.contact %></dd></div>
            <% if (job.crew) { %><div><dt><i class="bi bi-snow" aria-hidden="true"></i> AC No.</dt><dd><%= job.crew %></dd></div><% } %>
            <div><dt><i class="bi bi-chat-left-text" aria-hidden="true"></i> Problem</dt><dd><%= job.description %></dd></div>
          </dl>

          <form method="post" action="/technician/job-cards/<%= encodeURIComponent(job.arn) %>/receipt"
                enctype="multipart/form-data" class="receipt-form">
            <input type="file" name="receipt" id="receipt-<%= i %>" class="visually-hidden receipt-input"
                   accept="image/*,application/pdf" required>

            <label for="receipt-<%= i %>" class="btn btn-outline theme-primary btn-lg w-100 receipt-pick">
              <i class="bi bi-camera" aria-hidden="true"></i> Upload Signed Receipt
            </label>

            <div class="receipt-preview" hidden>
              <img alt="Preview of the selected receipt" class="receipt-thumb" hidden>
              <div class="receipt-file"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> <span></span></div>
              <div class="d-grid gap-3 mt-4">
                <button type="submit" class="btn btn-solid theme-success btn-lg receipt-submit">
                  <i class="bi bi-check2-circle" aria-hidden="true"></i> Submit &amp; Close Job
                </button>
                <label for="receipt-<%= i %>" class="btn btn-subtle theme-secondary">
                  <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Choose a different photo
                </label>
              </div>
            </div>
            <noscript>
              <button type="submit" class="btn btn-solid theme-success btn-lg w-100 mt-3">Submit &amp; Close Job</button>
            </noscript>
          </form>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</main>

<%- include("../partials/footer", { scripts: ["/js/technician.js"] }) %>
