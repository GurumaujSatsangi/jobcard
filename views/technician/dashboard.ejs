<%- include("../partials/head") %>
<%- include("../partials/header", { hideNotice: true }) %>

<main class="flex-grow-1 page">
  <div class="container tech-wrap">
    <div class="page-head">
      <h1>My Jobs</h1>
      <p><%= technician.name %> &middot; <%= sectionName %></p>
    </div>

    <% if (done) { %>
      <div class="flash flash-ok" role="status">
        <i class="bi bi-check-circle" aria-hidden="true"></i>
        <span><strong>Job <%= done %> is closed.</strong> The signed receipt was uploaded.</span>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="flash flash-err" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i><span><%= error %></span>
      </div>
    <% } %>

    <div class="list-head">
      <h2>Open jobs</h2>
      <span class="count"><%= jobs.length %> assigned to you</span>
    </div>

    <% if (!jobs.length) { %>
      <div class="panel empty">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <strong>No open jobs</strong>
        New jobs will appear here when they are assigned to you.
      </div>
    <% } %>

    <% jobs.forEach((job, i) => { %>
    <article class="panel job" id="job-<%= job.arn %>">
      <div class="panel-body">
        <div class="job-top">
          <div class="job-arn"><small>ARN</small><%= job.arn %></div>
          <span class="job-when">Assigned <%= job.assignedAt %></span>
        </div>

        <dl class="job-facts">
          <div><dt>Place</dt><dd><%= job.department %></dd></div>
          <div><dt>Contact</dt><dd><%= job.indentor %>, Ext. <%= job.contact %></dd></div>
          <% if (job.crew) { %><div><dt>AC number</dt><dd><%= job.crew %></dd></div><% } %>
          <div><dt>Problem</dt><dd><%= job.description %></dd></div>
        </dl>

        <form method="post" action="/technician/job-cards/<%= encodeURIComponent(job.arn) %>/receipt"
              enctype="multipart/form-data" class="receipt-form">
          <input type="file" name="receipt" id="receipt-<%= i %>" class="visually-hidden receipt-input"
                 accept="image/*,application/pdf" required>

          <label for="receipt-<%= i %>" class="btn btn-solid theme-primary btn-lg receipt-pick">
            <i class="bi bi-camera" aria-hidden="true"></i> Upload signed receipt
          </label>

          <div class="receipt-preview" hidden>
            <img alt="Preview of the selected receipt" class="receipt-thumb" hidden>
            <div class="receipt-file"><i class="bi bi-file-earmark" aria-hidden="true"></i> <span></span></div>
            <div class="d-grid gap-3 mt-4">
              <button type="submit" class="btn btn-solid theme-primary btn-lg receipt-submit">Submit and close job</button>
              <label for="receipt-<%= i %>" class="btn btn-outline theme-secondary">Choose a different photo</label>
            </div>
          </div>
          <noscript>
            <button type="submit" class="btn btn-solid theme-primary btn-lg w-100 mt-3">Submit and close job</button>
          </noscript>
        </form>
      </div>
    </article>
    <% }) %>
  </div>
</main>

<%- include("../partials/footer", { scripts: ["/js/technician.js"] }) %>
