<%- include("../partials/head") %>
<%- include("../partials/header", { hideNotice: true }) %>

<main class="flex-grow-1 page">
  <div class="container">
    <div class="panel signin">
      <div class="panel-body">
        <h1>Technician sign in</h1>
        <p class="sub">Enter your 6-digit passcode to continue</p>

        <% if (error) { %>
          <div class="flash flash-err text-start" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i><span><%= error %></span>
          </div>
        <% } %>

        <form method="post" action="/technician/login" id="techLoginForm" autocomplete="off">
          <label class="visually-hidden" for="passcode">Passcode</label>
          <div class="otp otp-lg justify-content-center mb-6" data-bs-otp data-bs-mask="true" data-bs-length="6">
            <input type="password" class="otp-input" id="passcode" name="passcode"
                   inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus
                   autocomplete="one-time-code" aria-describedby="passcodeHelp">
          </div>
          <button type="submit" class="btn btn-solid theme-primary btn-lg w-100" id="techLoginBtn">Sign in</button>
        </form>

        <p class="help" id="passcodeHelp">Forgot your passcode? Call the Help Desk at Extension <strong><%= HELPDESK.extension %></strong>.</p>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer", { scripts: ["/js/technician.js"] }) %>
