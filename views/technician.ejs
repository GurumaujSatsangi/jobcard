<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Document</title>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container">
        <h4>Technician Panel</h4>
        <hr>


 <% if(applications && applications.length>0) { %>

    <table class="table">
        <tr>
            <th>CREW Serial Number</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
<% applications.forEach(function(applications){ %>

<tr>
    <td><%= applications.crew_serial_number %></td>
    <td><%= applications.status %></td>
    <td><a class="btn btn-primary" href="">Update</a>
    <a class="btn btn-danger" href="">Report</a></td>

</tr>

    </table>

<% }) %>

<% } %>





    </div>
    <%- include('partials/footer') %>
</body>
</html>