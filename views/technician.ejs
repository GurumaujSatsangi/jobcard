<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Document</title>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container">
        <h4>Technician Panel</h4>
        <hr>


 <% if(applications && applications.length>0) { %>

    <table class="table">
        <tr>
            <th>ARN</th>
            <th>CREW Serial Number</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
<% applications.forEach(function(applications){ %>

<tr>
    <td><%= applications.arn %></td>
    <td><%= applications.crew_serial_number %></td>
    <td><%= applications.status %>
    
    <% if(applications.status=="MATERIAL ISSUED BY STORE IN-CHARGE"){ %>

        <p class="muted">ISSUED MATERIAL: <%= applications.material_issued %></p>
    
    <% } %>

</td>
    <td><form action="/update/<%= applications.arn %>" method="post">

        <input class="form-control" type="file" name="receipt"><br>
        <input type="submit" class="btn btn-primary" value="Update">
    </form>
    </td>

</tr>

    

<% }) %>
</table>
<% } %>





    </div>



    <%- include('partials/footer') %>
</body>
</html>