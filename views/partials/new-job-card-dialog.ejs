<dialog class="dialog dialog-lg dialog-scrollable" id="newJobCardDialog" aria-labelledby="newJobCardTitle">
  <div class="dialog-header">
    <h2 class="dialog-title" id="newJobCardTitle">New Job Card Application</h2>
    <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
  </div>

  <div class="dialog-body">
    <form id="jobCardForm" novalidate enctype="multipart/form-data">
      <div class="flash flash-err" id="formError" role="alert" hidden></div>

      <!-- Indentor -->
      <div class="form-section">
        <div class="form-section-title">Indentor details</div>

        <div class="row g-3 field">
          <div class="col-12 sm:col-6">
            <label class="form-label" for="firstName">First name <span class="req">*</span></label>
            <input type="text" class="form-control" id="firstName" name="firstName" required autocomplete="given-name">
            <div class="invalid-feedback" data-for="firstName">First name is required.</div>
          </div>
          <div class="col-12 sm:col-6">
            <label class="form-label" for="lastName">Last name <span class="req">*</span></label>
            <input type="text" class="form-control" id="lastName" name="lastName" required autocomplete="family-name">
            <div class="invalid-feedback" data-for="lastName">Last name is required.</div>
          </div>
        </div>

        <div class="field">
          <label class="form-label" for="email">Official email <span class="req">*</span></label>
          <input type="email" class="form-control" id="email" name="email" required autocomplete="email"
                 pattern="^[^\s@]+@<%= OFFICIAL_EMAIL_DOMAIN.replace('.', '\\.') %>$" placeholder="yourname@<%= OFFICIAL_EMAIL_DOMAIN %>" aria-describedby="emailHelp">
          <div class="form-text" id="emailHelp">Only @<%= OFFICIAL_EMAIL_DOMAIN %> addresses are accepted.</div>
          <div class="invalid-feedback" data-for="email">Please enter your official @<%= OFFICIAL_EMAIL_DOMAIN %> email.</div>
        </div>

        <div class="row g-3 field">
          <div class="col-12 sm:col-5">
            <label class="form-label" for="contactNumber">IACS extension no. <span class="req">*</span></label>
            <input type="text" inputmode="numeric" class="form-control" id="contactNumber" name="contactNumber" required pattern="\d{2,6}" maxlength="6">
            <div class="invalid-feedback" data-for="contactNumber">Enter a valid IACS extension number.</div>
          </div>
          <div class="col-12 sm:col-7">
            <label class="form-label" for="department">School / Department / Section / Unit <span class="req">*</span></label>
            <input type="text" class="form-control" id="department" name="department" required>
            <div class="invalid-feedback" data-for="department">This field is required.</div>
          </div>
        </div>
      </div>

      <!-- Work -->
      <div class="form-section">
        <div class="form-section-title">Work required</div>

        <div class="field" role="radiogroup" aria-labelledby="sectionLabel" aria-required="true">
          <span class="field-label" id="sectionLabel">Section <span class="req">*</span></span>
          <div class="choice-list two-col">
            <% SECTIONS.forEach((s, i) => { %>
            <label class="choice" for="section-<%= i %>">
              <input class="radio" type="radio" name="section" id="section-<%= i %>" value="<%= s.value %>" required>
              <span><%= s.label %></span>
            </label>
            <% }) %>
          </div>
          <div class="invalid-feedback" data-for="section">Please select a section.</div>
        </div>

        <div class="field" id="itemTypeGroup" role="radiogroup" aria-labelledby="itemTypeLabel" hidden>
          <span class="field-label" id="itemTypeLabel">Type of item to be repaired <span class="req">*</span></span>
          <div class="choice-list">
            <% AC_ITEM_TYPES.forEach((t, i) => { %>
            <label class="choice" for="itemType-<%= i %>">
              <input class="radio" type="radio" name="itemType" id="itemType-<%= i %>" value="<%= t.value %>">
              <span><%= t.label %></span>
            </label>
            <% }) %>
          </div>
          <div class="invalid-feedback" data-for="itemType">Please select the item type.</div>
        </div>

        <div id="crewGroup" hidden>
          <div class="field">
            <label class="form-label" for="crewSerialNumber">CREW serial number <span class="req">*</span></label>
            <div class="input-group">
              <input type="text" class="form-control text-uppercase" id="crewSerialNumber" name="crewSerialNumber" placeholder="e.g. IACS/CREW/AC/00001 or just 1" autocomplete="off" aria-describedby="crewHelp">
              <button type="button" class="btn btn-solid theme-primary" id="crewFetchBtn">Fetch data</button>
            </div>
            <div class="form-text" id="crewHelp">Printed on the CREW sticker on your AC. You can type only the number.</div>
            <div class="invalid-feedback" data-for="crewSerialNumber">CREW Serial Number is required.</div>
          </div>

          <div id="acDetails" hidden>
            <div class="field">
              <span class="field-label">Air conditioner details</span>
              <div class="table-responsive">
                <table class="kv-table"><tbody id="acDetailsBody"></tbody></table>
              </div>
            </div>
            <div class="field" role="radiogroup" aria-labelledby="detailsLabel">
              <span class="field-label" id="detailsLabel">Are the details above correct? <span class="req">*</span></span>
              <div class="d-flex flex-wrap gap-3">
                <label class="choice" for="detailsYes"><input class="radio" type="radio" name="detailsCorrect" id="detailsYes" value="yes"> Yes</label>
                <label class="choice" for="detailsNo"><input class="radio" type="radio" name="detailsCorrect" id="detailsNo" value="no"> No</label>
              </div>
              <div class="invalid-feedback" data-for="detailsCorrect">Please confirm the details.</div>
              <div class="form-text" id="detailsNoHint" hidden>Please mention the correct details in the description below.</div>
            </div>
          </div>
        </div>

        <div class="field">
          <label class="form-label" for="description">Description of the issue <span class="req">*</span></label>
          <textarea class="form-control" id="description" name="description" rows="4" required minlength="5" maxlength="2000"></textarea>
          <div class="invalid-feedback" data-for="description">Please describe the issue.</div>
        </div>

        <div class="field">
          <label class="form-label" for="attachments">Attachments <span class="text-muted-2 fw-normal">(optional)</span></label>
          <label class="dropzone" id="dropzone" for="attachments">
            <i class="bi bi-upload" aria-hidden="true"></i>
            <span><strong>Choose files</strong> or drag them here</span>
            <span class="form-text m-0">Up to 5 files &middot; JPG, PNG, WEBP or PDF &middot; 10 MB each</span>
            <input type="file" id="attachments" name="attachments" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" class="visually-hidden">
          </label>
          <ul class="file-list" id="fileList"></ul>
          <div class="invalid-feedback" data-for="attachments"></div>
        </div>
      </div>
    </form>

    <div id="jobCardSuccess" class="result-box" hidden>
      <i class="bi bi-check-circle" aria-hidden="true"></i>
      <h3 class="h5 mt-3 mb-1">Application submitted</h3>
      <p class="text-muted-2 mb-4">Your Application Reference Number (ARN) is</p>
      <div class="arn-chip">
        <span id="successArn"></span>
        <button type="button" class="btn btn-subtle theme-secondary btn-sm btn-icon" id="copyArnBtn" aria-label="Copy ARN"><i class="bi bi-copy" aria-hidden="true"></i></button>
      </div>
      <p class="small text-muted-2 mt-4 mb-0">Save this ARN. You need it to check the status of your job card.</p>
    </div>
  </div>

  <div class="dialog-footer">
    <button type="button" class="btn btn-subtle theme-secondary" data-bs-dismiss="dialog" id="jobCardCancelBtn">Cancel</button>
    <button type="submit" form="jobCardForm" class="btn btn-solid theme-primary" id="jobCardSubmitBtn">Submit application</button>
    <button type="button" class="btn btn-solid theme-primary" id="jobCardNewBtn" hidden>Submit another</button>
  </div>
</dialog>
