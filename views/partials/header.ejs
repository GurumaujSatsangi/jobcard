<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <img src="/img/logo.png" alt="IACS logo" width="34" height="34">
      <span class="brand-name">IACS <small><span class="d-none sm:d-inline">Online </span>Job Card Portal</small></span>
    </a>
    <nav class="header-links" aria-label="Main">
      <% if (locals.admin) { %>
        <span class="header-user d-none sm:d-inline"><i class="bi bi-person-circle" aria-hidden="true"></i> <%= admin.name %></span>
        <form method="post" action="/admin/logout" class="m-0">
          <button type="submit" class="header-link"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out</button>
        </form>
      <% } else if (locals.technician) { %>
        <span class="header-user d-none sm:d-inline"><i class="bi bi-person-circle" aria-hidden="true"></i> <%= technician.name %></span>
        <form method="post" action="/technician/logout" class="m-0">
          <button type="submit" class="header-link"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out</button>
        </form>
      <% } else { %>
        <a class="header-link" href="/technician/login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> <span class="d-none sm:d-inline">Technician </span>Login</a>
      <% } %>
      <button type="button" class="header-link" id="themeToggle" aria-label="Switch light or dark mode" title="Switch light / dark mode">
        <i class="bi bi-moon theme-icon-dark" aria-hidden="true"></i>
        <i class="bi bi-sun theme-icon-light" aria-hidden="true"></i>
      </button>
    </nav>
  </div>
</header>

<% if (!locals.hideNotice) { %>
<div class="notice">
  <div class="container">
    <i class="bi bi-info-circle" aria-hidden="true"></i>
    For any query, write to <a href="mailto:<%= HELPDESK.email %>"><%= HELPDESK.email %></a> or call Extension <%= HELPDESK.extension %>.
  </div>
</div>
<% } %>
