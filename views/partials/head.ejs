<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Indian Association for the Cultivation of Science</title>
  <meta name="description" content="Apply for and track job cards for the AC & Refrigeration, Glass Blowing, Electrical, Mechanical and Intercom / EPABX sections of IACS.">
  <link rel="icon" href="/img/logo.png">
  <script>
    // Apply the saved (or system) colour mode before first paint to avoid a flash.
    (function () {
      var saved = null;
      try { saved = localStorage.getItem("jc-theme"); } catch (e) {}
      var mode = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-bs-theme", mode);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
